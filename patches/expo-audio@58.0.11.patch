index 0000000000000000000000000000000000000000..35a12431d7aff418cc7431a637941369a207c518
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/TrackTransitionWakeLock.kt
@@ -0,0 +1,20 @@
+package expo.modules.audio
+
+import android.content.Context
+import android.os.PowerManager
+
+// ExoPlayer's own wake lock stops at STATE_ENDED. JS still needs time to
+// resolve the next authenticated/local source while the display stays off.
+internal class TrackTransitionWakeLock(context: Context) {
+  private val lock = (context.getSystemService(Context.POWER_SERVICE) as PowerManager)
+    .newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "YeongduMusic:TrackTransition")
+    .apply { setReferenceCounted(false) }
+
+  fun acquire() {
+    lock.acquire(30_000L)
+  }
+
+  fun release() {
+    if (lock.isHeld) lock.release()
+  }
+}
