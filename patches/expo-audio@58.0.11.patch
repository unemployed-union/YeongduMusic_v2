index 0000000000000000000000000000000000000000..c0d709a38b9ab446e343fd328e3409823e09168f
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/service/TrackNavigationPlayer.kt
@@ -0,0 +1,102 @@
+package expo.modules.audio.service
+
+import androidx.media3.common.FlagSet
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import expo.modules.audio.AudioLockScreenOptions
+import expo.modules.audio.AudioPlayer
+import java.util.IdentityHashMap
+
+// ExoPlayer holds one stream; JS owns authenticated queue navigation.
+@UnstableApi
+internal class TrackNavigationPlayer(
+  private val audioPlayer: AudioPlayer,
+  private val options: AudioLockScreenOptions?
+) : ForwardingPlayer(audioPlayer.ref) {
+  private val listeners = IdentityHashMap<Player.Listener, Player.Listener>()
+
+  private fun isLiveStream(): Boolean = options?.isLiveStream ?: audioPlayer.isLive
+
+  // App seekTo() already operates directly on this ExoPlayer. Expose the same
+  // operation for explicitly on-demand, finite music, even if its remote
+  // extractor omits the seek command. Never invent a duration or enable live/ad seek.
+  private fun canSeekOnDemand(): Boolean =
+    options?.isLiveStream == false &&
+      !audioPlayer.isLive &&
+      !super.isPlayingAd() &&
+      !super.getCurrentTimeline().isEmpty &&
+      super.getDuration() > 0
+
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands().buildUpon()
+    if (isLiveStream()) {
+      commands.remove(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+    } else if (canSeekOnDemand()) {
+      commands.add(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+    }
+    if (options?.showNextTrack == true) {
+      commands.add(Player.COMMAND_SEEK_TO_NEXT).add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    }
+    if (options?.showPreviousTrack == true) {
+      commands.add(Player.COMMAND_SEEK_TO_PREVIOUS).add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+    }
+    return commands.build()
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean = availableCommands.contains(command)
+
+  override fun seekToNext() {
+    if (options?.showNextTrack == true) audioPlayer.requestTrackNavigation("next") else super.seekToNext()
+  }
+
+  override fun seekToNextMediaItem() {
+    if (options?.showNextTrack == true) audioPlayer.requestTrackNavigation("next") else super.seekToNextMediaItem()
+  }
+
+  override fun seekToPrevious() {
+    if (options?.showPreviousTrack == true) audioPlayer.requestTrackNavigation("previous") else super.seekToPrevious()
+  }
+
+  override fun seekToPreviousMediaItem() {
+    if (options?.showPreviousTrack == true) audioPlayer.requestTrackNavigation("previous") else super.seekToPreviousMediaItem()
+  }
+
+  override fun addListener(listener: Player.Listener) {
+    var reportedCommands = availableCommands
+    var commandsChanged = false
+    fun notifyCommandsIfChanged() {
+      val current = availableCommands
+      if (current != reportedCommands) {
+        reportedCommands = current
+        commandsChanged = true
+        listener.onAvailableCommandsChanged(current)
+      }
+    }
+    val forwarding = object : ForwardingPlayerListener(listener) {
+      override fun onAvailableCommandsChanged(commands: Player.Commands) {
+        notifyCommandsIfChanged()
+      }
+      override fun onEvents(player: Player, events: Player.Events) {
+        // A network item may reveal its duration through a timeline event without
+        // changing ExoPlayer's original commands. MediaSession must observe ours.
+        notifyCommandsIfChanged()
+        val forwardedEvents = if (commandsChanged) {
+          val flags = FlagSet.Builder()
+          for (index in 0 until events.size()) flags.add(events.get(index))
+          flags.add(Player.EVENT_AVAILABLE_COMMANDS_CHANGED)
+          Player.Events(flags.build())
+        } else events
+        commandsChanged = false
+        listener.onEvents(this@TrackNavigationPlayer, forwardedEvents)
+      }
+    }
+    val previous = listeners.put(listener, forwarding)
+    if (previous != null) super.removeListener(previous)
+    super.addListener(forwarding)
+  }
+
+  override fun removeListener(listener: Player.Listener) {
+    super.removeListener(listeners.remove(listener) ?: listener)
+  }
+}
