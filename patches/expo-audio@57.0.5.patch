index 0000000000000000000000000000000000000000..ff1841400c7b3a97deabdc60f6d94988189f4b6c
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/service/TrackNavigationPlayer.kt
@@ -0,0 +1,67 @@
+package expo.modules.audio.service
+
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import expo.modules.audio.AudioLockScreenOptions
+import expo.modules.audio.AudioPlayer
+import java.util.IdentityHashMap
+
+// ExoPlayer holds one stream; the app's queue handles authenticated next/previous tracks.
+// Advertise standard commands for Android 13+ System UI and keep listener state consistent.
+@UnstableApi
+internal class TrackNavigationPlayer(
+  private val audioPlayer: AudioPlayer,
+  private val options: AudioLockScreenOptions?,
+  private val isLive: Boolean
+) : ForwardingPlayer(audioPlayer.ref) {
+  private val listeners = IdentityHashMap<Player.Listener, Player.Listener>()
+
+  override fun getAvailableCommands(): Player.Commands {
+    val commands = super.getAvailableCommands().buildUpon()
+    if (isLive) commands.remove(Player.COMMAND_SEEK_IN_CURRENT_MEDIA_ITEM)
+    if (options?.showSkipNext == true) {
+      commands.add(Player.COMMAND_SEEK_TO_NEXT).add(Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    }
+    if (options?.showSkipPrevious == true) {
+      commands.add(Player.COMMAND_SEEK_TO_PREVIOUS).add(Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+    }
+    return commands.build()
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean = availableCommands.contains(command)
+
+  override fun seekToNext() {
+    if (options?.showSkipNext == true) audioPlayer.requestTrackNavigation("next") else super.seekToNext()
+  }
+
+  override fun seekToNextMediaItem() {
+    if (options?.showSkipNext == true) audioPlayer.requestTrackNavigation("next") else super.seekToNextMediaItem()
+  }
+
+  override fun seekToPrevious() {
+    if (options?.showSkipPrevious == true) audioPlayer.requestTrackNavigation("previous") else super.seekToPrevious()
+  }
+
+  override fun seekToPreviousMediaItem() {
+    if (options?.showSkipPrevious == true) audioPlayer.requestTrackNavigation("previous") else super.seekToPreviousMediaItem()
+  }
+
+  override fun addListener(listener: Player.Listener) {
+    val forwarding = object : Player.Listener by listener {
+      override fun onAvailableCommandsChanged(commands: Player.Commands) {
+        listener.onAvailableCommandsChanged(this@TrackNavigationPlayer.availableCommands)
+      }
+      override fun onEvents(player: Player, events: Player.Events) {
+        listener.onEvents(this@TrackNavigationPlayer, events)
+      }
+    }
+    val previous = listeners.put(listener, forwarding)
+    if (previous != null) super.removeListener(previous)
+    super.addListener(forwarding)
+  }
+
+  override fun removeListener(listener: Player.Listener) {
+    super.removeListener(listeners.remove(listener) ?: listener)
+  }
+}
