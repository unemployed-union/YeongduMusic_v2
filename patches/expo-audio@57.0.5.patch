+  @Override public void onPlaylistMetadataChanged(androidx.media3.common.MediaMetadata arg0) {
+    listener.onPlaylistMetadataChanged(arg0);
+  }
+
+  @Override public void onIsLoadingChanged(boolean arg0) {
