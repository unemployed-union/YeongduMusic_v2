+package expo.modules.audio.service;
+
+import androidx.media3.common.Player;
+import androidx.media3.common.util.UnstableApi;
+
+// Kotlin 'Player.Listener by listener' does not delegate Java default methods.
+// Both session wrappers need all callbacks, including timeline and seek results.
+// Keep this forwarding list aligned with our pinned Media3 1.9.0 Player.Listener.
+@UnstableApi
+@SuppressWarnings("deprecation")
+abstract class ForwardingPlayerListener implements Player.Listener {
+  protected final Player.Listener listener;
+
+  ForwardingPlayerListener(Player.Listener listener) {
+    this.listener = listener;
+  }
+
+  @Override public void onEvents(androidx.media3.common.Player arg0, androidx.media3.common.Player.Events arg1) {
+    listener.onEvents(arg0, arg1);
+  }
+
+  @Override public void onTimelineChanged(androidx.media3.common.Timeline arg0, int arg1) {
+    listener.onTimelineChanged(arg0, arg1);
+  }
+
+  @Override public void onMediaItemTransition(androidx.media3.common.MediaItem arg0, int arg1) {
+    listener.onMediaItemTransition(arg0, arg1);
+  }
+
+  @Override public void onTracksChanged(androidx.media3.common.Tracks arg0) {
+    listener.onTracksChanged(arg0);
+  }
+
+  @Override public void onMediaMetadataChanged(androidx.media3.common.MediaMetadata arg0) {
+    listener.onMediaMetadataChanged(arg0);
+  }
