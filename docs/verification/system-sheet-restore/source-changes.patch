-  private var surface: UIView { backdrop.opaqueSurface }
-  private var displayLink: CADisplayLink?
-  private let target = SheetDisplayLinkTarget()
-  private var geometrySize: CGSize?
-  private var geometryInset: CGFloat?
-  private let surfaces: SettingsSheetSurfaces
-  #if targetEnvironment(simulator)
-  private var lastLoggedProgress: Int = -1
-  #endif
