-    displayLink = link
-    update()
-  }
-
-  func stop() {
-    displayLink?.invalidate()
-    displayLink = nil
-    surfaces.unregister(surface)
-    backdrop.removeFromSuperview()
-  }
-
-  deinit {
-    displayLink?.invalidate()
-  }
