-  init(sheet: UISheetPresentationController) {
-    self.sheet = sheet
-    surfaces = SettingsSheetSurfaces.forSheet(sheet)
-    surface.backgroundColor = .systemGroupedBackground
-    surface.isUserInteractionEnabled = false
-    surface.isAccessibilityElement = false
-    surface.alpha = 0
-    target.owner = self
-  }
-
-  func setColorScheme(_ scheme: UIUserInterfaceStyle) {
-    backdrop.overrideUserInterfaceStyle = scheme
-  }
-
-  func start() {
-    guard let view = sheet?.presentedViewController.view else {
-      return
-    }
-    backdrop.frame = view.bounds
-    backdrop.autoresizingMask = [.flexibleWidth, .flexibleHeight]
-    view.insertSubview(backdrop, at: 0)
-    surfaces.register(surface)
-    if UIAccessibility.isReduceTransparencyEnabled {
