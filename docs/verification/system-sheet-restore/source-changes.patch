-/// Reads the public presentation-layer geometry on the main/UI thread, including
-/// UIKit's post-release spring. No JS frame events, scroll offsets or detent-arrival fade.
-private final class SheetBackgroundMotion {
-  weak var sheet: UISheetPresentationController?
