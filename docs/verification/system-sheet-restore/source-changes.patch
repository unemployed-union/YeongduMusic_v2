-  func update() {
-    guard let sheet, let view = sheet.presentedView, let container = sheet.containerView,
-      let lower = resolvedHeights[0], let upper = resolvedHeights[1],
-      lower.isFinite, upper.isFinite, upper > lower else {
-      return
-    }
-    // Capture safe-area attachment geometry once, not at a selected-detent event.
-    // UIKit's model bounds can still be the full size during initial presentation;
-    // waiting for them to equal the lower detent would miss the first drag.
-    if geometrySize != container.bounds.size {
