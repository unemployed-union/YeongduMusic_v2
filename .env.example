# Optional local-only NAS address for diagnostics. Not bundled into the app.
# Copy to .env.local and enter your address there; do not commit .env.local.
NAS_URL=

# Public OAuth client IDs for iOS, never client_secret. iOS URL scheme requires rebuild.
# Android Drive uses its registered package + SHA-1 and does not request a backend ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=513932420837-8oov6cq1j16gu3akdcigglm2d0n7r9j7.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
