# QA/cloud builds use an explicit application-source allowlist.
*
!src
!src/**
!assets
!assets/**
!modules
!modules/**
!plugins
!plugins/**
!patches
!patches/**
!scripts
!scripts/**
!app.json
!eas.json
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!build-version.json
!babel.config.js
!babel.config.cjs
!metro.config.js
!metro.config.cjs
!react-native.config.js

# Never include local credentials, environments, generated projects or caches.
**/.env*
**/*.p8
**/*.p12
**/*.jks
**/*.key
**/*.pem
**/*.mobileprovision
**/.DS_Store
**/node_modules/**
**/.git/**
**/.expo/**
**/.gradle/**
**/.cxx/**
modules/**/build/**
modules/**/ios/build/**
